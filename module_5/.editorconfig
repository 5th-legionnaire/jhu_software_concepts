# Formatting the editor enforces, so Pylint's format checks hold without
# anyone having to remember them (CHG-17 in CHANGES.md).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
# Pylint's default max-line-length.
max_line_length = 100

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a Markdown line break.
trim_trailing_whitespace = false
