# Copy to .env (gitignored) and fill in real values. Never commit .env.
#
# Runtime (least-privilege) account the web app and Pull Data use.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gradcafedb
DB_USER=gradcafe_app
DB_PASSWORD=change-me
# Owner account: schema setup and bulk load only. Keep it out of the running app's environment.
# DB_OWNER_USER=gradcafe_owner
# DB_OWNER_PASSWORD=change-me
# Optional single-URL override, used by CI and tests. Takes precedence over DB_*.
# DATABASE_URL=postgresql+psycopg://gradcafe_app:change-me@localhost:5432/gradcafedb
# Disposable database the test suite truncates before and after db tests. Never point
# this at real data. Unset, the offline tests still run and the db tests fail with a
# message saying so.
TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/gradcafe_test
